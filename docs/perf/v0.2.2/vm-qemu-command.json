[
  "qemu-system-x86_64",
  "-name",
  "phobos-vm22",
  "-enable-kvm",
  "-machine",
  "q35",
  "-cpu",
  "host,kvm-steal-time=on,kvm-hint-dedicated=on",
  "-smp",
  "4,sockets=1,cores=4,threads=1",
  "-m",
  "4096",
  "-overcommit",
  "mem-lock=on",
  "-object",
  "memory-backend-ram,id=ram,size=4G,prealloc=on",
  "-numa",
  "node,memdev=ram",
  "-nodefaults",
  "-no-reboot",
  "-display",
  "none",
  "-nic",
  "none",
  "-kernel",
  "/boot/vmlinuz-linux-cachyos",
  "-append",
  "root=/dev/vda rw init=/init console=ttyS0 loglevel=4 nokaslr nowatchdog idle=poll nohz_full=1-3 rcu_nocbs=1-3 irqaffinity=0",
  "-drive",
  "file=/home/maci/.cache/phobos-vm22/root.img,if=virtio,format=raw,cache=none",
  "-serial",
  "file:/home/maci/.cache/phobos-vm22/serial.log",
  "-qmp",
  "unix:/home/maci/.cache/phobos-vm22/qmp.sock,server=on,wait=off",
  "-S"
]
