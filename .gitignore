# Zig
.zig-cache/
zig-out/
# Moonraker reference checkout and unused SQLite extension header stay local.
/vendor/*
!/vendor/sqlite/
/vendor/sqlite/sqlite3ext.h
# Conformance golden captures are large; track selectively later
/conformance/golden/*.raw
# Python bytecode + local envs/caches
__pycache__/
*.pyc
.venv/
.pytest_cache/
.testenv/

# Editor / OS junk + stray backups
*.orig
*.bak
*.swp
.DS_Store
zig-pkg/
.scratch/
